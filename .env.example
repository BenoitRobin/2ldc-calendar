# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais commiter le fichier .env (déjà exclu via .gitignore).

# --- Base de données (Turso / libSQL) ---
# En développement local, peut pointer vers un fichier SQLite local, ex: file:local.db
# En production, URL fournie par Turso (ex: libsql://<nom-base>-<org>.turso.io)
TURSO_DATABASE_URL=
# Jeton d'authentification Turso (non requis pour une base locale)
TURSO_AUTH_TOKEN=

# --- Authentification (better-auth) ---
# Clé secrète utilisée pour signer les sessions/cookies — générer une valeur aléatoire longue
BETTER_AUTH_SECRET=
# URL de base de l'application (utilisée pour les callbacks/cookies)
# Dev: http://localhost:5173 — Prod: URL Vercel (ex: https://2ldc-calendar.vercel.app)
BETTER_AUTH_URL=

# --- Email transactionnel (Resend) ---
# Laisser vide en développement : les emails seront simplement loggés en console
RESEND_API_KEY=
# Adresse d'envoi vérifiée côté Resend (ex: notifications@votredomaine.fr)
RESEND_FROM_EMAIL=
