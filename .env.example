# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais commiter le fichier .env (déjà exclu via .gitignore).

# --- Base de données (Turso / libSQL) ---
# En développement local : un fichier SQLite local, ex: file:local.db
# En production : l'URL libSQL fournie par Turso (ex: libsql://<nom-base>-<org>.turso.io)
DATABASE_URL=file:local.db
# Jeton d'authentification Turso (laisser vide pour une base locale)
TURSO_AUTH_TOKEN=

# --- Authentification (better-auth) ---
# Clé secrète utilisée pour signer les sessions/cookies — générer une valeur aléatoire longue
BETTER_AUTH_SECRET=
# Origine de confiance pour les cookies/callbacks
# Dev: http://localhost:5173 — Prod: URL Vercel (ex: https://2ldc-calendar.vercel.app)
ORIGIN=

# --- Mails aux membres (Resend) ---
# Clé API Resend (https://resend.com/api-keys). Absente en local : les mails sont
# seulement affichés dans la console, rien n'est envoyé.
RESEND_API_KEY=
# Expéditeur. Sans domaine vérifié dans Resend, seul onboarding@resend.dev
# fonctionne, et uniquement vers l'adresse du compte Resend.
MAIL_FROM="2LDC Calendrier <onboarding@resend.dev>"
